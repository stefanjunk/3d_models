{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/build-polished-firebase-apps/app-blueprint.schema.json",
  "title": "Firebase web app product blueprint",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "name",
    "slug",
    "brief",
    "archetype",
    "status",
    "product",
    "assumptions",
    "routes",
    "flows",
    "roles",
    "entities",
    "visual",
    "firebase",
    "compliance",
    "acceptance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "brief": { "type": "string", "minLength": 1 },
    "archetype": {
      "enum": ["marketing", "saas", "utility", "commerce", "affiliate", "marketplace", "content", "community", "portal"]
    },
    "status": { "enum": ["draft", "reviewed", "building", "prototype-ready", "deploy-ready", "launch-ready", "blocked"] },
    "product": {
      "type": "object",
      "required": ["one_liner", "primary_user", "moment_of_use", "job_to_be_done", "success_action", "success_metric", "non_goals"],
      "properties": {
        "one_liner": { "type": "string" },
        "primary_user": { "type": "string" },
        "moment_of_use": { "type": "string" },
        "job_to_be_done": { "type": "string" },
        "success_action": { "type": "string" },
        "success_metric": { "type": "string" },
        "non_goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "basis", "risk", "reversible", "validation", "status"],
        "properties": {
          "statement": { "type": "string" },
          "basis": { "type": "string" },
          "risk": { "enum": ["low", "medium", "high", "critical"] },
          "reversible": { "type": "boolean" },
          "validation": { "type": "string" },
          "status": { "enum": ["assumed", "verified", "rejected", "needs-input"] }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "purpose", "audience", "primary_action", "data", "indexing"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "purpose": { "type": "string" },
          "audience": { "type": "array", "items": { "type": "string" } },
          "primary_action": { "type": "string" },
          "data": { "type": "array", "items": { "type": "string" } },
          "indexing": { "enum": ["index", "noindex", "private"] }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "steps", "recovery_states"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["primary", "secondary", "recovery", "administrative"] },
          "steps": { "type": "array", "items": { "type": "string" } },
          "recovery_states": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "owner", "sensitivity", "retention", "source_of_truth", "fields"],
        "properties": {
          "name": { "type": "string" },
          "owner": { "type": "string" },
          "sensitivity": { "enum": ["public", "internal", "personal", "sensitive", "regulated"] },
          "retention": { "type": "string" },
          "source_of_truth": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "visual": {
      "type": "object",
      "required": ["thesis", "desired_moods", "forbidden_moods", "signature_layout", "typography", "color_logic", "surface_language", "asset_treatment", "motion_signature"],
      "properties": {
        "thesis": { "type": "string" },
        "desired_moods": { "type": "array", "items": { "type": "string" } },
        "forbidden_moods": { "type": "array", "items": { "type": "string" } },
        "signature_layout": { "type": "string" },
        "typography": { "type": "string" },
        "color_logic": { "type": "string" },
        "surface_language": { "type": "string" },
        "asset_treatment": { "type": "string" },
        "motion_signature": { "type": "string" }
      }
    },
    "firebase": {
      "type": "object",
      "required": ["hosting_profile", "environments", "region_status", "products", "auth_model", "rules_model", "app_check", "secrets", "observability", "cost_controls"],
      "properties": {
        "hosting_profile": { "enum": ["hosting", "app-hosting", "cloud-run", "undecided"] },
        "environments": { "type": "array", "items": { "type": "string" } },
        "region_status": { "enum": ["unresolved", "reviewed", "provisioned"] },
        "products": { "type": "array", "items": { "type": "string" } },
        "auth_model": { "type": "string" },
        "rules_model": { "type": "string" },
        "app_check": { "type": "string" },
        "secrets": { "type": "string" },
        "observability": { "type": "array", "items": { "type": "string" } },
        "cost_controls": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compliance": {
      "type": "object",
      "required": ["profile", "target_markets", "flags", "data_categories", "vendors", "retention_status", "launch_blockers"],
      "properties": {
        "profile": { "enum": ["global-strict", "market-configured"] },
        "target_markets": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "data_categories": { "type": "array", "items": { "type": "string" } },
        "vendors": { "type": "array", "items": { "type": "string" } },
        "retention_status": { "enum": ["unresolved", "defined", "implemented"] },
        "launch_blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "criterion", "proof"],
        "properties": {
          "area": { "type": "string" },
          "criterion": { "type": "string" },
          "proof": { "type": "string" }
        }
      }
    }
  }
}
