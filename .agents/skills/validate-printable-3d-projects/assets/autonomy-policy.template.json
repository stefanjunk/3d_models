    {"id": "mesh-generation", "approval": "agent", "evidence_mode": "deterministic-pass", "require_hashed_report_inputs": true},
    {"id": "interface-validation", "approval": "agent", "evidence_mode": "deterministic-pass", "require_hashed_report_inputs": true},
    {"id": "slicer-preflight", "approval": "agent", "evidence_mode": "deterministic-pass", "require_hashed_report_inputs": true},
