{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/validate-printable-3d-projects/interface-contract.schema.json",
  "title": "Printable assembly interface contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parts", "interfaces", "motions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "parts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "transform": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {"type": "number"}
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "a", "b", "mode", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "a": {"type": "string"},
          "b": {"type": "string"},
          "mode": {"enum": ["overlap", "clearance"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "motions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "moving", "stationary", "translation_mm", "steps", "max_intersection_volume_mm3", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "moving": {"type": "string"},
          "stationary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "translation_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "steps": {"type": "integer", "minimum": 1, "maximum": 10000},
          "max_step_mm": {"type": "number", "exclusiveMinimum": 0},
          "ignore_step_zero": {"type": "boolean"},
          "accept_discrete": {"type": "boolean"},
          "max_intersection_volume_mm3": {"type": "number", "minimum": 0},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
