{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrimade.local/schemas/p2-stage-manifest.schema.json",
  "title": "P2 digital-candidate artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "artifacts", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "sku", "name", "revision", "lifecycle_stage", "root"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "sku": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "lifecycle_stage": {"type": "string", "pattern": "^P2(?:\\s|$)"},
        "root": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description_en", "concept_image", "rendered_image", "print_set_3mf"],
      "properties": {
        "description_en": {"$ref": "#/$defs/fileArtifact"},
        "concept_image": {
          "allOf": [
            {"$ref": "#/$defs/fileArtifact"},
            {
              "type": "object",
              "required": ["scope", "approval_state"],
              "properties": {
                "language": {"const": "en"},
                "scope": {"const": "whole-product"},
                "approval_state": {"enum": ["approved", "pending", "retrospective-unapproved"]}
              }
            }
          ]
        },
        "rendered_image": {
          "allOf": [
            {"$ref": "#/$defs/fileArtifact"},
            {
              "type": "object",
              "required": ["basis"],
              "properties": {"basis": {"const": "current-model"}}
            }
          ]
        },
        "print_set_3mf": {
          "allOf": [
            {"$ref": "#/$defs/fileArtifact"},
            {
              "type": "object",
              "required": ["all_print_parts_included", "print_parts", "orientation", "supports"],
              "properties": {
                "all_print_parts_included": {"const": true},
                "print_parts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "quantity"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "quantity": {"type": "integer", "minimum": 1}
                    }
                  }
                },
                "orientation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "encoding", "summary"],
                  "properties": {
                    "status": {"const": "considered"},
                    "encoding": {"enum": ["3mf-build-transform", "embedded-slicer-project"]},
                    "summary": {"type": "string", "minLength": 12}
                  }
                },
                "supports": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "mode", "encoding", "summary"],
                  "properties": {
                    "status": {"const": "considered"},
                    "mode": {"enum": ["disabled", "enabled", "mixed"]},
                    "encoding": {"enum": ["embedded-slicer-project", "linked-exact-profile"]},
                    "summary": {"type": "string", "minLength": 12},
                    "profile_artifacts": {
                      "type": "array",
                      "items": {"$ref": "#/$defs/fileArtifact"}
                    },
                    "slice_report": {"$ref": "#/$defs/fileArtifact"}
                  }
                }
              }
            }
          ]
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "fileArtifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
