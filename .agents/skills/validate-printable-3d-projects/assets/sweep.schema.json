{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/validate-printable-3d-projects/sweep.schema.json",
  "title": "Deterministic parameter sweep",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "command", "parameters", "timeout_seconds", "output_root", "validators"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["default"],
        "properties": {"default": {}, "min": {}, "max": {}}
      }
    },
    "cases": {"type": "array"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "output_root": {"type": "string", "minLength": 1},
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["mesh", "mesh_compare", "gcode", "3mf", "interfaces"]},
          "path": {"type": "string"},
          "reference": {"type": "string"},
          "candidate": {"type": "string"},
          "policy": {"type": "object"}
        }
      }
    }
  }
}
