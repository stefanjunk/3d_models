{
  "schema_version": "1.0",
  "project": {
    "id": "example-part",
    "revision": "R1",
    "units": "mm",
    "risk_class": "normal-functional",
    "build_volume_mm": [400, 400, 450]
  },
  "artifacts": [
    {
      "id": "manufacturing-mesh",
      "path": "exports/example.stl",
      "kind": "mesh",
      "revision": "R1"
    },
    {
      "id": "autonomy-policy",
      "path": "autonomy-policy.json",
      "kind": "autonomy-policy",
      "revision": "R1"
    },
    {
      "id": "agent-approval-ledger",
      "path": "validation/agent-approvals.json",
      "kind": "approval-ledger",
      "revision": "R1"
    }
  ],
  "checks": [
    {
      "id": "manufacturing-mesh-audit",
      "type": "mesh",
      "required": true,
      "artifact": "manufacturing-mesh",
      "policy": {
        "require_watertight": true,
        "require_winding_consistent": true,
        "require_positive_volume": true,
        "expected_components": 1,
        "max_boundary_edges": 0,
        "max_nonmanifold_edges": 0,
        "max_degenerate_faces": 0,
        "max_duplicate_faces": 0,
        "bed_mm": [400, 400, 450],
        "allow_axis_permutation": false,
        "max_faces": 1000000,
        "max_file_mib": 100
      }
    },
    {
      "id": "print-candidate-approvals",
      "type": "approvals",
      "required": true,
      "policy_artifact": "autonomy-policy",
      "agent_ledger_artifact": "agent-approval-ledger",
      "target_stage": "print-candidate"
    },
    {
      "id": "physical-fit",
      "type": "physical",
      "required": false,
      "status": "REVIEW_REQUIRED",
      "criterion": "Post-candidate manual gate: process-matched interface coupon passes",
      "evidence_artifact": null
    }
  ],
  "release": {
    "required_approvals": [],
    "approvals": {}
  }
}
