{
  "schema_version": 1,
  "purpose": "Conservative commercial and proprietary distribution allowlist",
  "allowed": {
    "permissive": [
      "MIT",
      "Apache-2.0",
      "0BSD",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "CC0-1.0"
    ],
    "attribution_required": [
      "CC-BY-1.0",
      "CC-BY-2.0",
      "CC-BY-2.5",
      "CC-BY-3.0",
      "CC-BY-4.0"
    ],
    "self_owned_only": [
      "LicenseRef-Proprietary"
    ]
  },
  "blocked_families": [
    "GPL",
    "LGPL",
    "AGPL",
    "CC-BY-SA",
    "CC-BY-NC",
    "CC-BY-ND",
    "UNKNOWN",
    "NOASSERTION"
  ],
  "requirements": {
    "third_party_asset_sha256": true,
    "third_party_source_url": true,
    "redistributed_license_file": true,
    "cc_by_fields": [
      "title",
      "author",
      "license_url",
      "modifications"
    ]
  },
  "limitations": [
    "This policy is a technical compliance gate, not legal advice.",
    "License approval does not establish patent, trademark, regulatory, safety, or dimensional clearance."
  ]
}
