{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commercial CAD provenance manifest",
  "type": "object",
  "required": ["project", "items"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "origin", "license"],
        "properties": {
          "id": {"type": "string"},
          "kind": {
            "enum": [
              "generated_geometry",
              "library",
              "embedded_data",
              "third_party_asset",
              "downloaded_cad"
            ]
          },
          "origin": {"enum": ["self", "third_party"]},
          "license": {"type": "string"},
          "source_url": {"type": "string"},
          "version_or_commit": {"type": "string", "minLength": 1},
          "sha256": {"type": "string"},
          "artifact_path": {"type": "string"},
          "distribution": {"enum": ["build_only", "redistributed"]},
          "license_file": {"type": "string"},
          "license_sha256": {"type": "string"},
          "attribution": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "author": {"type": "string"},
              "license_url": {"type": "string"},
              "modifications": {"type": "string"}
            }
          }
        }
        ,
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
