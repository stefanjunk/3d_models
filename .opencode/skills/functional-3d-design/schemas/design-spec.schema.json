{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/functional-3d-design/design-spec.schema.json",
  "title": "Functional 3D Design Specification",
  "type": "object",
  "required": ["project", "workflow", "branding", "function", "risk", "fabrication", "printer", "manufacturing", "acceptance"],
  "properties": {
    "project": {"type": "object", "required": ["id", "revision"]},
    "workflow": {
      "type": "object",
      "required": ["requirements_approval", "concept_approval", "watermark_approval"],
      "properties": {
        "requirements_approval": {
          "type": "object",
          "required": ["status", "spec_revision"],
          "properties": {
            "status": {"enum": ["pending", "approved", "changes-requested"]},
            "spec_revision": {"type": ["string", "null"]},
            "approved_by": {"type": ["string", "null"]},
            "approved_at": {"type": ["string", "null"]}
          }
        },
        "concept_approval": {
          "type": "object",
          "required": ["status", "spec_revision", "asset"],
          "properties": {
            "status": {"enum": ["blocked", "pending", "approved", "changes-requested"]},
            "spec_revision": {"type": ["string", "null"]},
            "asset": {"type": ["string", "null"]},
            "approved_by": {"type": ["string", "null"]},
            "approved_at": {"type": ["string", "null"]}
          }
        },
        "watermark_approval": {
          "type": "object",
          "required": ["status", "spec_revision", "geometry_revision", "asset_id", "variant", "placement", "preview_asset", "validation_asset"],
          "properties": {
            "status": {"enum": ["blocked", "pending", "approved", "changes-requested"]},
            "spec_revision": {"type": ["string", "null"]},
            "geometry_revision": {"type": ["string", "null"]},
            "asset_id": {"const": "JSI-WM-001-R1"},
            "variant": {"enum": ["standard", "compact", null]},
            "placement": {"type": ["string", "null"]},
            "preview_asset": {"type": ["string", "null"]},
            "validation_asset": {"type": ["string", "null"]},
            "approved_by": {"type": ["string", "null"]},
            "approved_at": {"type": ["string", "null"]}
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "required": ["required", "brand", "asset_id", "operation", "preferred_surface", "depth_mm"],
      "properties": {
        "required": {"const": true},
        "brand": {"const": "JuSt Innovation"},
        "asset_id": {"const": "JSI-WM-001-R1"},
        "operation": {"const": "recessed"},
        "preferred_surface": {"const": "print-bed-facing-underside"},
        "depth_mm": {"type": "number", "minimum": 0.2, "maximum": 0.8}
      }
    },
    "function": {"type": "object", "required": ["summary"]},
    "risk": {
      "type": "object",
      "required": ["class"],
      "properties": {"class": {"enum": ["decorative", "normal-functional", "structural", "safety-critical"]}}
    },
    "fabrication": {
      "type": "object",
      "required": ["preference"],
      "properties": {"preference": {"enum": ["integrated-print", "balanced-hybrid", "standard-hardware"]}}
    },
    "printer": {
      "type": "object",
      "required": ["build_volume_mm"],
      "properties": {
        "build_volume_mm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "manufacturing": {
      "type": "object",
      "required": ["material", "nozzle_mm"],
      "properties": {"nozzle_mm": {"type": "number", "exclusiveMinimum": 0}}
    },
    "acceptance": {"type": "array", "minItems": 1}
  }
}
