{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Parts Library Entry",
  "type": "object",
  "required": ["part_id", "revision", "status", "source_type", "category"],
  "properties": {
    "part_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "revision": {"type": "string"},
    "status": {"enum": ["concept", "experimental", "qualified-local", "deprecated"]},
    "source_type": {"enum": ["printed", "purchased", "hybrid"]},
    "category": {"type": "string"},
    "validation": {"type": "array"},
    "test_evidence": {"type": "array"}
  }
}
