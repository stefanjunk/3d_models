{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corresponding 3D landmarks",
  "type": "object",
  "required": ["source_points_mm", "target_points_mm"],
  "properties": {
    "source_points_mm": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "target_points_mm": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "allow_uniform_scale": {"type": "boolean", "default": false}
  }
}
