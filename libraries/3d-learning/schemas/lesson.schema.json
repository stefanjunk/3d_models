{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrimade.local/schemas/3d-learning/lesson.schema.json",
  "title": "Scoped 3D lesson record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "id", "title", "captured_at", "source_type",
    "lifecycle", "feature", "scope", "observation", "explanation",
    "evidence", "applicability", "relationships", "validation", "provenance", "tags"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "lesson"},
    "id": {"type": "string", "pattern": "^EXP-[0-9]{5}$"},
    "title": {"type": "string", "minLength": 8},
    "captured_at": {"type": "string", "format": "date"},
    "source_type": {
      "enum": ["design-trace", "print-test", "user-correction", "benchmark", "external-evidence"]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "maturity", "confidence", "review"],
      "properties": {
        "state": {"enum": ["candidate", "validated", "rejected", "deprecated"]},
        "maturity": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["pending", "changes-requested", "approved", "rejected"]},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_at": {"type": ["string", "null"], "format": "date"},
            "notes": {"type": "string"}
          }
        },
        "rejection_reason": {"type": "string"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry"],
      "properties": {
        "type": {"type": "string", "minLength": 2},
        "geometry": {"type": "string", "minLength": 2},
        "design_parameters": {"type": "object"},
        "named_datums": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "machine", "material", "nozzle", "orientation", "slicer"],
      "properties": {
        "process": {"type": "string", "minLength": 2},
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manufacturer", "model"],
          "properties": {
            "manufacturer": {"type": "string"},
            "model": {"type": "string"},
            "unit_id": {"type": ["string", "null"]},
            "firmware": {"type": ["string", "null"]}
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manufacturer", "product"],
          "properties": {
            "manufacturer": {"type": "string"},
            "product": {"type": "string"},
            "variant": {"type": ["string", "null"]},
            "color": {"type": ["string", "null"]},
            "batch": {"type": ["string", "null"]},
            "conditioning": {"type": ["string", "null"]}
          }
        },
        "nozzle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diameter_mm", "material"],
          "properties": {
            "diameter_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "material": {"type": "string"},
            "geometry": {"type": ["string", "null"]},
            "hotend": {"type": ["string", "null"]},
            "wear_state": {"type": ["string", "null"]}
          }
        },
        "orientation": {"type": "string"},
        "slicer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": ["string", "null"]},
            "profile": {"type": ["string", "null"]},
            "profile_hash": {"type": ["string", "null"]}
          }
        },
        "geometry_class": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "transfer_limits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expected", "actual", "outcome"],
      "properties": {
        "summary": {"type": "string", "minLength": 8},
        "expected": {},
        "actual": {},
        "outcome": {"enum": ["success", "failure", "mixed", "correction"]},
        "parameter": {"type": ["string", "null"]},
        "recommended_value": {},
        "units": {"type": ["string", "null"]}
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "mechanism", "alternatives", "validated"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 8},
        "mechanism": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "validated": {"type": "boolean"},
        "validation_method": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations", "same_scope_repetitions", "geometry_count",
        "machine_count", "material_count", "nozzle_count", "measured",
        "sources", "artifacts"
      ],
      "properties": {
        "observations": {"type": "integer", "minimum": 1},
        "same_scope_repetitions": {"type": "integer", "minimum": 0},
        "geometry_count": {"type": "integer", "minimum": 0},
        "machine_count": {"type": "integer", "minimum": 0},
        "material_count": {"type": "integer", "minimum": 0},
        "nozzle_count": {"type": "integer", "minimum": 0},
        "measured": {"type": "boolean"},
        "measurement_method": {"type": ["string", "null"]},
        "uncertainty": {"type": ["string", "null"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "ref"],
            "properties": {
              "type": {"enum": ["product-trace", "measurement", "user-statement", "manufacturer", "research", "other"]},
              "ref": {"type": "string", "minLength": 1},
              "hash": {"type": ["string", "null"]},
              "notes": {"type": "string"}
            }
          }
        },
        "artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "exclusions", "transfer_limits"],
      "properties": {
        "triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "transfer_limits": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duplicates", "conflicts", "supersedes", "related", "evals", "patterns", "references"],
      "properties": {
        "duplicates": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "related": {"type": "array", "items": {"type": "string"}},
        "evals": {"type": "array", "items": {"type": "string", "pattern": "^EVAL-[A-Za-z0-9-]+$"}},
        "patterns": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targeted", "regression"],
      "properties": {
        "targeted": {"enum": ["not-run", "pass", "fail", "review-required"]},
        "regression": {"enum": ["not-run", "pass", "fail", "review-required"]},
        "reports": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "part_revision", "trace", "created_by"],
      "properties": {
        "project": {"type": "string"},
        "part_revision": {"type": ["string", "null"]},
        "trace": {"type": "string"},
        "source_commit": {"type": ["string", "null"]},
        "created_by": {"type": "string"}
      }
    },
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
