{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "/workspace/3d_models/.agents/skills"
    ]
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/workspace/3d_models/.agents/skills/**": "allow",
      "/workspace/3d_models/.agents/skills/*": "allow",
      "/workspace/3d_models/**": "allow",
      "/workspace/Website/metrimade-store/**":"allow",
      "/tmp/opencode/**": "allow",
      "/tmp/opencode/*": "allow",
    },
    "bash": {
      "*": "ask",
      "python *": "allow",
      "python3 *": "allow",
      ".venv/bin/python ./*": "allow",
      "python -m pytest *": "allow",
      "python3 -m pytest *": "allow",
      "uv run python *": "allow",
      "git *": "allow",
      "sha256sum *": "allow",
      "git fetch": "allow",
      "firebase":"allow"
    }
  }
}
