  "geometry": {
    "parameter_file": "../../config/model-params.json",
    "relief_adapter_config": "../../config/relief-config.json",
    "cwd": "../..",
    "command": [
      "python3",
      "src/build_pipeline.py"
    ],
    "output_path": "../../output/DRAFT/DRAFT-R1.3-aspect-safe-030mm-assembly.3mf",
