    "layer_height_mm": 0.2,
    "axis_mode": "xy-xy canonical tile; remapped to XY-Z on vertical bands"
  },
  "mapping": {
    "surface_type": "organizer floors and planar wall bands",
    "placement_mode": "repeating object-space tile",
    "axis_mode": "mixed",
    "intended_surface_mapping": "repeat over enabled floor, inner-wall, and recessed outer-wall patches"
  },
  "classification": {
    "image_class": "texture",
    "polarity": "white-high",
    "repeating": true,
    "seamless_x": true,
    "seamless_y": true
  },
  "image": {
    "class": "texture",
    "repeating": true,
    "fit_mode": "repeat",
    "aspect_policy": "preserve",
    "allow_aspect_distortion": false,
    "aspect_tolerance_pct": 1.5,
    "bit_depth": 16
  },
  "processing": {
    "repeat_tile": {
      "size_policy": "preserve_source_aspect",
      "anchor_axis": "width",
      "anchor_mm": 180.0
    },
    "seam_blend_mm": [
      7.0,
      7.0
    ],
    "black_point": 0.0,
    "white_point": 1.0,
    "gamma": 1.0,
    "invert": false,
    "background_gray": 32768
