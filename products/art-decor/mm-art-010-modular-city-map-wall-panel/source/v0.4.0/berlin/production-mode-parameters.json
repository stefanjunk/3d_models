{
  "schema_version": "1.0",
  "project": "MM-ART-010",
  "revision": "0.4.0-production-candidate",
  "pilot": "Berlin",
  "units": "mm",
  "parameter_status": "decomposition-approved-digital-candidate",
  "concept_parameter_authority": "source/v0.4.0/berlin/display-mode-parameters.json",
  "display_mode": {
    "type": "enum",
    "allowed": ["boundary_crop", "context_outline"],
    "default": "boundary_crop"
  },
  "shared": {
    "maximum_assembled_envelope_mm": [600.0, 400.0],
    "main_print_count": 2,
    "nominal_vertical_split_x_mm": 300.0,
    "uniform_geospatial_scale": true,
    "maximum_simultaneous_filaments": 4,
    "palette": {
      "Bone White": "#E9E1D0",
      "Nardo Grey": "#73777A",
      "Black": "#171717",
      "Orange": "#F05A24"
    },
    "dithering": false,
    "rear_grid": false,
    "replaceable_sections": false,
    "optional_backlight_preparation": true,
    "outside_source_policy": "fail_closed_when_frozen_source_does_not_cover_the_selected_context_extent"
  },
  "modes": {
    "boundary_crop": {
      "customer_label_de": "Nur Berlin",
      "outside_geometry": "remove",
      "outer_perimeter": "berlin_administrative_boundary",
      "rectangular_backer": false,
      "boundary_marker": false,
      "fit_rule": "uniformly_fit_boundary_into_maximum_envelope",
      "minimum_perimeter_feature_mm": 2.0,
      "printed_free_area_outside_boundary": 0.0,
      "assembly_note": "The two permanent prints are clipped after all semantic layers and rear interfaces share one global Berlin frame."
    },
    "context_outline": {
      "customer_label_de": "Berlin mit Umland",
      "outside_geometry": "retain",
      "outer_perimeter": "rectangle",
      "rectangular_backer": true,
      "fit_rule": "uniformly_fit_selected_context_extent_into_full_600_by_400_frame",
      "context_margin_ratio": {
        "default": 0.12,
        "minimum": 0.05,
        "maximum": 0.3,
        "definition": "minimum fraction of Berlin boundary width and height added on every side before aspect completion"
      },
      "frame_aspect_policy": {
        "target_width_to_height": 1.5,
        "rule": "apply the selected minimum margin on both axes, then symmetrically expand only the shorter source axis until the context extent is 3:2; never crop or distort",
        "default_result": {
          "vertical_margin_ratio_per_side": 0.12,
          "horizontal_margin_ratio_per_side": 0.26654580495423386,
          "bounds_epsg25833": [357796.5793918899, 5794991.9300077595, 427990.7480931101, 5841788.04247524]
        }
      },
      "boundary_marker": {
        "enabled": true,
        "semantic_color": "Orange",
        "nominal_width_mm": 2.4,
        "nominal_height_above_black_mm": 0.4,
        "minimum_ligament_to_aperture_mm": 2.0
      },
      "source_requirement": "Use a new immutable metropolitan Berlin/Brandenburg extract that covers the complete selected context extent; the v0.3.0 Berlin-only PBF is insufficient for production."
    }
  },
  "gate_note": "Requirements, concept v03 and mode-aware decomposition are human-approved. These parameters authorize DRAFT source, CAD, mesh and target-slicer evidence only; print-candidate and release remain human-controlled."
}
