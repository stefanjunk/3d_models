    {"id": "interface-report", "path": "reports/interface-report.json", "kind": "report", "revision": "R1"},
    {"id": "slicer-report", "path": "reports/slicer-preflight.json", "kind": "report", "revision": "R1"},
    {"id": "autonomy-policy", "path": "autonomy-policy.json", "kind": "autonomy-policy", "revision": "R1"},
    {"id": "agent-ledger", "path": "validation/agent-approvals.json", "kind": "approval-ledger", "revision": "R1"},
    {"id": "physical-fit-form", "path": "reports/physical-fit-results.md", "kind": "human-evidence-form", "revision": "R1"}
