    {"id": "badge-teal", "path": "build/exports/metrimade-badge-teal.stl", "kind": "mesh", "revision": "R1"},
    {"id": "badge-aqua", "path": "build/exports/metrimade-badge-aqua.stl", "kind": "mesh", "revision": "R1"},
