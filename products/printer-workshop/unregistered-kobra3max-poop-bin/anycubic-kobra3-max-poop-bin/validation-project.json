      "expected_inputs": ["body", "bracket", "gauge", "badge-sand", "badge-navy", "badge-teal", "badge-aqua"],
      "report": "reports/aggregate-mesh-check.json"
    },
    {
      "id": "deterministic-3mf-suite",
      "type": "external_report",
      "required": true,
      "artifact": "three-mf-report",
      "expected_inputs": ["kit-3mf", "badge-3mf"],
      "report": "reports/aggregate-3mf-check.json"
    },
    {
      "id": "digital-interface-suite",
      "type": "external_report",
      "required": true,
      "artifact": "interface-report",
      "expected_inputs": ["bracket", "gauge", "body"],
      "report": "reports/aggregate-interface-check.json"
    },
    {
      "id": "slicer-preflight",
      "type": "external_report",
      "required": true,
      "artifact": "slicer-report",
      "expected_inputs": ["body", "bracket", "badge-3mf"],
      "report": "reports/aggregate-slicer-check.json"
    },
    {
      "id": "workflow-approvals",
      "type": "approvals",
      "required": true,
      "policy_artifact": "autonomy-policy",
      "agent_ledger_artifact": "agent-ledger",
      "target_stage": "print-candidate",
      "report": "reports/aggregate-approvals-check.json"
    },
    {
      "id": "physical-fit-and-function",
      "type": "physical",
      "required": false,
      "status": "REVIEW_REQUIRED",
      "criterion": "Print the fit gauge, verify hardware and machine clearance, then run full travel and three supervised purge cycles.",
      "evidence_artifact": "physical-fit-form",
      "report": "reports/aggregate-physical-check.json"
    },
    {
      "id": "appearance-and-commercial-review",
      "type": "review",
      "required": false,
      "status": "REVIEW_REQUIRED",
      "criterion": "Confirm logo rights, printed color appearance, safety information and outgoing license before commercial release.",
      "evidence_artifact": null,
      "report": "reports/aggregate-commercial-check.json"
    }
  ],
  "release": {
    "required_approvals": [],
    "approvals": {}
  }
